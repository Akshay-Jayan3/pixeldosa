  },
  "css": {
    "@layer base": {
      "svg[aria-hidden=\"true\"], [data-pd-decorative]": {
        "user-select": "none",
        "-webkit-user-select": "none"
      }
    },
    "@keyframes pd-fade-in": {
      "from": {
        "opacity": "0"
      },
      "to": {
        "opacity": "1"
      }
    },
    "@keyframes pd-cell-pulse": {
      "0%, 100%": {
        "transform": "scale(0.3)"
      },
      "50%": {
        "transform": "scale(0.9)"
      }
    },
    "@keyframes pd-cell-pulse-opacity": {
      "0%, 100%": {
        "opacity": "0.08"
      },
      "50%": {
        "opacity": "0.5"
      }
    },
    "@keyframes pd-sweep": {
      "0%": {
        "transform": "translateX(-100%)"
      },
      "100%": {
        "transform": "translateX(100%)"
      }
    },
    "@keyframes pd-shimmer": {
      "from": {
        "background-position": "180% 0"
      },
      "to": {
        "background-position": "-80% 0"
      }
    },
    "@supports ((-webkit-background-clip: text) or (background-clip: text))": {
      ".pd-shimmer": {
        "background-image": "linear-gradient(90deg, var(--muted-foreground) 0%, var(--muted-foreground) 35%, var(--foreground) 50%, var(--muted-foreground) 65%, var(--muted-foreground) 100%)",
        "background-size": "250% 100%",
        "-webkit-background-clip": "text",
        "background-clip": "text",
        "color": "transparent",
        "animation": "pd-shimmer 2.4s linear infinite"
      }
    },
    "@media (prefers-reduced-motion: reduce)": {
      ".pd-shimmer": {
        "animation": "none",
        "background-image": "none",
        "-webkit-background-clip": "border-box",
        "background-clip": "border-box",
        "color": "inherit"
      }
    },
    "@keyframes pd-status-swap": {
      "from": {
        "opacity": "0",
        "transform": "translateY(3px)"
      },
      "to": {
        "opacity": "1",
        "transform": "translateY(0)"
      }
    },
    "@keyframes pd-orb-spin": {
      "from": {
        "transform": "rotateY(0deg)"
      },
      "to": {
        "transform": "rotateY(360deg)"
      }
    }
  },
  "meta": {
    "engineeringNotes": "Shipped as a registry:theme item rather than baked into each component so that colour is a project-level decision made once, not a per-component import that would break the moment a consumer wants their own palette. Colours are OKLCH rather than HSL so the light and dark scales can be derived from matched perceptual lightness steps; the practical payoff is that a token pair like muted/muted-foreground holds its contrast ratio across both modes without per-mode hand-tuning. Motion values are emitted as CSS custom properties in addition to the TypeScript exports, so components that need only a CSS transition can honour the motion scale without pulling in a JS animation runtime.",
    "motionNotes": "This item defines the motion scale rather than animating anything itself. Durations are exposed in milliseconds (CSS) and seconds (TypeScript/Motion) from one source, because emitting only one unit guarantees a conversion bug at the first component that needs the other."
  },
  "docs": "The cssVars in this item are generated from packages/tokens. Do not edit them here — change the token module and rebuild.",
  "categories": [
    "core",
    "theme"
  ],
  "type": "registry:theme"
}