{
  "extends": "@pixeldosa/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/registry/*": ["../../packages/ui/src/registry/*"],
      "@/registry-pro/*": ["../../packages/ui/src/registry-pro/*"],
      "@/*": ["./*"]
    },
    "moduleResolution": "Bundler",
    "module": "ESNext"
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
